{
  "entities": {
    "Member": {
      "collection": "members",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "employeeId": { "type": "string", "required": true },
        "department": { "type": "string", "required": true },
        "role": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "phone": { "type": "string", "required": false },
        "joinDate": { "type": "string", "required": true },
        "shift": { "type": "string", "required": true },
        "avatarColor": { "type": "string", "required": true },
        "avatarUrl": { "type": "string", "required": false },
        "active": { "type": "boolean", "required": true }
      }
    },
    "AttendanceRecord": {
      "collection": "attendance",
      "fields": {
        "id": { "type": "string", "required": true },
        "memberId": { "type": "string", "required": true },
        "date": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "checkInTime": { "type": "string", "required": false },
        "checkOutTime": { "type": "string", "required": false },
        "notes": { "type": "string", "required": false },
        "updatedAt": { "type": "string", "required": true }
      }
    },
    "AuditLog": {
      "collection": "audit_logs",
      "fields": {
        "id": { "type": "string", "required": true },
        "timestamp": { "type": "string", "required": true },
        "eventType": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "role": { "type": "string", "required": false },
        "details": { "type": "string", "required": true }
      }
    },
    "LeaveRequest": {
      "collection": "leaves",
      "fields": {
        "id": { "type": "string", "required": true },
        "memberId": { "type": "string", "required": true },
        "memberName": { "type": "string", "required": true },
        "employeeId": { "type": "string", "required": false },
        "department": { "type": "string", "required": false },
        "avatarColor": { "type": "string", "required": false },
        "leaveType": { "type": "string", "required": true },
        "startDate": { "type": "string", "required": true },
        "endDate": { "type": "string", "required": true },
        "totalDays": { "type": "number", "required": true },
        "reason": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "appliedAt": { "type": "string", "required": true },
        "reviewedAt": { "type": "string", "required": false },
        "reviewedBy": { "type": "string", "required": false },
        "adminRemark": { "type": "string", "required": false }
      }
    },
    "UserAccount": {
      "collection": "user_accounts",
      "fields": {
        "id": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "role": { "type": "string", "required": true },
        "memberId": { "type": "string", "required": false },
        "passwordHash": { "type": "string", "required": false },
        "salt": { "type": "string", "required": false },
        "plainPassword": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": false },
        "failedLoginAttempts": { "type": "number", "required": false }
      }
    }
  }
}
